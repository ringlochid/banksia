# Oh My Subagents does not load .env files implicitly. Export selected values into the
# process environment, or place them in an explicit service environment file.
# OMS_ nested keys use double underscores.

OMS_ENV=development
OMS_DEBUG=true

# Postgres from docker-compose (host port 5433). Omit to fall back to local SQLite.
OMS_DATABASE_URL=postgresql+asyncpg://oms:oms@localhost:5433/oms
