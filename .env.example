# Banksia does not load .env files implicitly. Export selected values into the
# process environment, or place them in an explicit service environment file.
# BANKSIA_ nested keys use double underscores.

BANKSIA_ENV=development
BANKSIA_DEBUG=true

# Postgres from docker-compose (host port 5433). Omit to fall back to local SQLite.
BANKSIA_DATABASE_URL=postgresql+asyncpg://banksia:banksia@localhost:5433/banksia
