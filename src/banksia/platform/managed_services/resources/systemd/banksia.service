[Unit]
Description=Banksia local control plane
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart="@BANKSIA_PYTHON@" -m banksia serve --config "@BANKSIA_CONFIG@" --service-log "@BANKSIA_SERVICE_LOG@"
Restart=on-failure
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
