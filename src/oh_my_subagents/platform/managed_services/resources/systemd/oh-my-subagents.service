[Unit]
Description=Oh My Subagents local control plane
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart="@OMS_PYTHON@" -m oh_my_subagents serve --config "@OMS_CONFIG@" --service-log "@OMS_SERVICE_LOG@"
Restart=on-failure
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
